# Browser configuration. Copy to .env.local, fill values, then restart Vite.
# Safe public project values only. Never paste a service-role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable each button only after configuring its provider in Supabase Auth.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false

# Cloudflare, webhook, SMTP and OAuth secrets belong in their service dashboards
# or Supabase Edge Function secrets; never use a VITE_ prefix for secrets.

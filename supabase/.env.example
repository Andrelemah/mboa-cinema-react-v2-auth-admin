# Server-only template. Copy to supabase/.env.local and fill with real secrets.
# Never prefix any of these with VITE_. Never commit the completed file.
# Exact browser origins, comma separated. No paths, fragments, trailing slash or *.
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_32_CHARACTER_ACCOUNT_ID
CLOUDFLARE_STREAM_API_TOKEN=REPLACE_WITH_STREAM_EDIT_TOKEN
STREAM_CUSTOMER_CODE=REPLACE_WITH_CUSTOMER_CODE_FROM_STREAM_EMBED
STREAM_WEBHOOK_SECRET=REPLACE_WITH_CLOUDFLARE_GENERATED_WEBHOOK_SECRET
MAX_VIDEO_BYTES=10737418240

# Paystack server configuration. Keep the secret key server-side only.
# Set PAYMENTS_ENABLED=true only after test-mode checkout and webhook verification pass.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_SECRET_KEY
PAYSTACK_CURRENCY=XAF
PAYSTACK_SUBUNIT_FACTOR=1
PAYSTACK_CHANNELS=card,mobile_money
PAYSTACK_PLAN_MOBILE_AMOUNT=3000
PAYSTACK_PLAN_PLUS_AMOUNT=5000
PAYSTACK_CALLBACK_URL=http://127.0.0.1:5173/?payment=return
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are automatically
# provided to hosted Supabase Edge Functions; do not expose them in frontend env.
